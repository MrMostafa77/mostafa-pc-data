rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /gamevault/{doc} {
      allow read, write: if true;
    }
    match /gamevault_store/{key} {
      allow read, write: if true;
      match /chunks/{chunkId} {
        allow read, write: if true;
      }
    }
    match /covers/{gameId} {
      allow read, write: if true;
      match /chunks/{chunkId} {
        allow read, write: if true;
      }
    }
  }
}
